<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.nhom4project.auctionweb.controller.frontend.ItemManagementController"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../style/item_management.css"
            styleClass="item-root">

    <top>
        <HBox spacing="16" styleClass="item-topbar">
            <Button text="Quay lại bảng điều khiển" onAction="#onBack" styleClass="back-button"/>
            <Label text="Quản lý sản phẩm" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="scroll-pane-content">
            <content>
                <HBox spacing="20" styleClass="item-content">
                    <!-- Left: Form -->
                    <VBox spacing="14" prefWidth="380" styleClass="form-panel">
                        <Label text="Thêm sản phẩm mới" styleClass="section-title"/>

                        <VBox spacing="4">
                            <Label text="Loại sản phẩm" styleClass="field-label"/>
                            <ComboBox fx:id="typeCombo" maxWidth="Infinity" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Tên sản phẩm" styleClass="field-label"/>
                            <TextField fx:id="nameField" promptText="Nhập tên sản phẩm" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Mô tả" styleClass="field-label"/>
                            <TextArea fx:id="descField" promptText="Mô tả sản phẩm" prefRowCount="3" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Giá khởi điểm (VND)" styleClass="field-label"/>
                            <TextField fx:id="priceField" promptText="Ví dụ: 1000000" styleClass="input-field"/>
                        </VBox>

                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="extra1Label" text="Nhãn hiệu:" styleClass="field-label"/>
                                <TextField fx:id="extra1Field" styleClass="input-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label fx:id="extra2Label" text="Dòng máy/Đời:" styleClass="field-label"/>
                                <TextField fx:id="extra2Field" styleClass="input-field"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="Thêm" onAction="#onAddItem" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Cập nhật" onAction="#onUpdateItem" styleClass="warning-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Xóa" onAction="#onDeleteItem" styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <!-- Tạo phiên đấu giá -->
                        <Separator/>
                        <Label text="Tạo phiên đấu giá" styleClass="section-title"/>

                        <VBox spacing="4">
                            <Label text="Thời gian đấu giá" styleClass="field-label"/>
                            <HBox spacing="8">
                                <TextField fx:id="durationValueField" text="3" prefWidth="100" styleClass="input-field"/>
                                <ComboBox fx:id="durationUnitCombo" prefWidth="120" styleClass="input-field"/>
                            </HBox>
                        </VBox>
                        <Button text="Tạo phiên đấu giá" onAction="#onCreateAuction" styleClass="primary-button"/>

                        <Label fx:id="statusLabel" text="" styleClass="status-label"/>
                    </VBox>

                    <!-- Right: Table -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="table-panel">
                        <Label text="Danh sách sản phẩm của bạn" styleClass="section-title"/>
                        <TableView fx:id="itemTable" VBox.vgrow="ALWAYS" styleClass="item-table">
                            <columns>
                                <TableColumn fx:id="nameColumn" text="Tên" prefWidth="200"/>
                                <TableColumn fx:id="typeColumn" text="Loại" prefWidth="120"/>
                                <TableColumn fx:id="priceColumn" text="Giá khởi điểm" prefWidth="150"/>
                                <TableColumn fx:id="descColumn" text="Mô tả" prefWidth="250"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
