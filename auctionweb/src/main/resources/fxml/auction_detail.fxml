>>>>>>> Stashed changes
                        </VBox>

                        <!-- Bid History -->
                        <VBox spacing="8" styleClass="history-card" prefHeight="250">
                            <Label text="Lịch sử đặt giá" styleClass="section-title"/>
                            <ListView fx:id="bidHistoryList" VBox.vgrow="ALWAYS" styleClass="history-list"/>
                        </VBox>
                    </VBox>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
