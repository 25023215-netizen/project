<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane fx:controller="com.nhom4project.auctionweb.controller.frontend.AuctionDetailController"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../style/auction_detail.css"
            styleClass="detail-root">

    <!-- Top Bar -->
    <top>
        <HBox spacing="16" styleClass="detail-topbar">
            <Button text="Quay lại" onAction="#onBack" styleClass="back-button"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" text="Đang tải..." styleClass="detail-title"/>
                <Label fx:id="categoryLabel" text="" styleClass="detail-subtitle"/>
            </VBox>
            <Label fx:id="statusLabel" text="" styleClass="status-badge"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="scroll-pane-content">
            <content>
                <HBox spacing="20" styleClass="detail-content">
                    <!-- Left: Info + Bidding -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="left-panel">
                        <!-- Auction Info Card -->
                        <VBox spacing="10" styleClass="info-card">
                            <Label fx:id="descriptionLabel" text="" wrapText="true" styleClass="desc-text"/>
                            <HBox spacing="30">
                                <VBox spacing="4">
                                    <Label text="Giá hiện tại" styleClass="info-label"/>
                                    <Label fx:id="currentPriceLabel" text="0 VND" styleClass="price-text"/>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="Lượt đặt giá" styleClass="info-label"/>
                                    <Label fx:id="bidCountLabel" text="0" styleClass="bid-count-text"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="endTimeLabel" text="Kết thúc: -" styleClass="info-label"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="timerLabel" text="00:00:00" styleClass="timer-text"/>
                            </HBox>
                            <Label fx:id="winnerLabel" text="" styleClass="winner-text"/>
                            <Label fx:id="userStatusLabel" text="" styleClass="user-status-text"/>
                        </VBox>

                        <!-- Place Bid Card -->
                        <VBox spacing="10" styleClass="bid-card">
                            <Label text="Đặt giá" styleClass="section-title"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="bidAmountField" promptText="Nhập số tiền (VND)" styleClass="bid-input" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="placeBidButton" text="Đặt giá" onAction="#onPlaceBid" styleClass="bid-button"/>
                            </HBox>
                            <Label fx:id="messageLabel" text="" styleClass="message-label"/>
                        </VBox>

                        <!-- Auto-Bid Card -->
                        <VBox spacing="10" styleClass="autobid-card">
                            <Label text="Đấu giá tự động (Auto-Bid)" styleClass="section-title"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Giá tối đa" styleClass="info-label"/>
                                    <TextField fx:id="maxBidField" promptText="Giá tối đa (VND)" styleClass="bid-input"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Bước giá" styleClass="info-label"/>
                                    <TextField fx:id="incrementField" promptText="Bước tăng (VND)" styleClass="bid-input"/>
                                </VBox>
                                <Button fx:id="autoBidButton" text="Kích hoạt" onAction="#onAutoBid" styleClass="autobid-button"/>
                                <Button fx:id="stopAutoBidButton" text="Dừng Auto-bid" onAction="#onStopAutoBid" styleClass="stop-autobid-button" managed="false" visible="false"/>
                            </HBox>
                            <Label fx:id="minBidLabel" text="Gợi ý: Đặt từ - VND" styleClass="info-label" style="-fx-text-fill: #64748b;"/>
                        </VBox>

                        <!-- Owner/Admin Actions Card -->
                        <VBox fx:id="managementCard" spacing="10" styleClass="management-card" managed="false" visible="false">
                            <Label text="Quản lý phiên đấu giá" styleClass="section-title"/>
                            <HBox spacing="10">
                                <Button fx:id="endEarlyButton" text="Kết thúc sớm" onAction="#onEndAuctionEarly" styleClass="danger-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="deleteAuctionButton" text="Xóa phiên đấu giá" onAction="#onDeleteAuction" styleClass="delete-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Right: Chart + History -->
                    <VBox spacing="16" prefWidth="440" styleClass="right-panel">
                        <!-- Price Chart -->
                        <VBox spacing="8" styleClass="chart-card" VBox.vgrow="ALWAYS">
                            <Label text="Biểu đồ giá (Realtime)" styleClass="section-title"/>
<<<<<<< Updated upstream
