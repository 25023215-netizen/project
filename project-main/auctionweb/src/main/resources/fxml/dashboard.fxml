<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.nhom4project.auctionweb.controller.frontend.DashboardController"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../style/dashboard.css"
            styleClass="dashboard-root">
    
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="20" styleClass="sidebar">
            <padding><Insets top="20" right="0" bottom="20" left="20"/></padding>
            
            <!-- Logo Section -->
            <VBox spacing="8" alignment="TOP_LEFT">
                <Label text="⚡ AUCTION" styleClass="brand-title"/>
                <Label text="Hệ thống đấu giá trực tuyến" styleClass="brand-subtitle"/>
            </VBox>
            
            <!-- Navigation Menu -->
            <VBox spacing="10" styleClass="nav-list" VBox.vgrow="ALWAYS">
                <Label text="CHÍNH" styleClass="nav-section-title"/>
                <Button text="🏠 Trang chủ" styleClass="nav-button-active"/>
                <Button text="🔨 Phiên đấu giá" onAction="#onRefresh" styleClass="nav-button"/>
                <Button text="📦 Đặt giá" styleClass="nav-button"/>
                
                <Separator styleClass="nav-separator"/>
                <Label text="HỆ THỐNG" styleClass="nav-section-title"/>
                <Button text="📋 Quản lý sản phẩm" fx:id="manageItemsButton" onAction="#onManageItems" styleClass="nav-button"/>
            </VBox>
            
            <!-- Logout Button (Bottom) -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                <Button text="🚪 Đăng xuất" onAction="#onLogout" styleClass="nav-logout-btn" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
            
            <!-- TOP HEADER =-->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-section">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="👋 Chào mừng đến với Hệ thống Đấu giá" styleClass="page-title"/>
                    <Label fx:id="userInfoLabel" text="Quản lý phiên đấu giá, đặt giá và theo dõi kết quả đề đắng" styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="adminInfoLabel" styleClass="admin-balance" text="💰 Số dư: 10,000,000 VND"/>
            </HBox>
            
            <!-- STATS CARDS ROW -->
            <HBox spacing="16" styleClass="stats-row">
                <!-- Card 1: Auctions -->
                <VBox spacing="12" styleClass="stat-card stat-card-blue" HBox.hgrow="ALWAYS">
                    <Label text="🔨" styleClass="stat-icon"/>
                    <VBox spacing="4">
                        <Label text="Phiên đấu giá" styleClass="stat-label"/>
                        <Label fx:id="totalAuctionsLabel" text="12" styleClass="stat-value"/>
                    </VBox>
                </VBox>
                
                <!-- Card 2: Running Auctions -->
                <VBox spacing="12" styleClass="stat-card stat-card-pink" HBox.hgrow="ALWAYS">
                    <Label text="⏱️" styleClass="stat-icon"/>
                    <VBox spacing="4">
                        <Label text="Lượt đặt giá" styleClass="stat-label"/>
                        <Label text="48" styleClass="stat-value"/>
                    </VBox>
                </VBox>
                
                <!-- Card 3: Users -->
                <VBox spacing="12" styleClass="stat-card stat-card-cyan" HBox.hgrow="ALWAYS">
                    <Label text="👥" styleClass="stat-icon"/>
                    <VBox spacing="4">
                        <Label text="Người dùng" styleClass="stat-label"/>
                        <Label text="156" styleClass="stat-value"/>
                    </VBox>
                </VBox>
                
                <!-- Card 4: Completed -->
                <VBox spacing="12" styleClass="stat-card stat-card-green" HBox.hgrow="ALWAYS">
                    <Label text="✅" styleClass="stat-icon"/>
                    <VBox spacing="4">
                        <Label text="Đã hoàn thành" styleClass="stat-label"/>
                        <Label text="8" styleClass="stat-value"/>
                    </VBox>
                </VBox>
            </HBox>
            
            <!-- MAIN CONTENT PANEL -->
            <VBox spacing="14" styleClass="content-panel" VBox.vgrow="ALWAYS">
                <!-- Panel Header -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🔍 Danh sách Phiên đấu giá" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="Tìm kiếm tên..." styleClass="search-field" prefWidth="250"/>
                    <Button text="🔄 Làm mới" onAction="#onRefresh" styleClass="refresh-btn"/>
                </HBox>
                
                <!-- Data Table -->
                <TableView fx:id="auctionTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" text="Sản phẩm" prefWidth="220"/>
                        <TableColumn fx:id="categoryColumn" text="Giá khởi điểm" prefWidth="120"/>
                        <TableColumn fx:id="priceColumn" text="Giá hiện tại" prefWidth="130"/>
                        <TableColumn fx:id="bidsColumn" text="Người bán" prefWidth="140"/>
                        <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="100"/>
                        <TableColumn fx:id="endTimeColumn" text="Thời gian kết thúc" prefWidth="155"/>
                    </columns>
                </TableView>
                
                <!-- Footer Info -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <Label fx:id="statusLabel" text="Tổng: 12 phiên đấu giá" styleClass="footer-info"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>


